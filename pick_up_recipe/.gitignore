# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Продукты кодогенерации: собираются командой
# dart run build_runner build --delete-conflicting-outputs
# и в CI, поэтому в репозитории им делать нечего.
*.g.dart
*.gr.dart

# Исключение — lib/l10n/app_localizations*.dart: их делает `flutter pub get`
# по .arb, а анализ и тесты — нет. Без них в репозитории дерево не собирается
# сразу после клона, поэтому эти генераты лежат рядом с .arb.

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# FVM Version Cache
.fvm/
# Ключи подписи: единственный файл в проекте, потеря которого необратима,
# и единственный, чья утечка отдаёт право выпускать обновления кому угодно.
android/keystore.properties
*.jks
*.keystore
