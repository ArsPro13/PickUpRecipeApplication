# Ключ подписи Android.
#
# Скопируйте в android/keystore.properties и заполните. Сам файл и keystore
# в гит НЕ попадают: подписной ключ — это право выпускать обновления вашего
# приложения, и его утечка означает, что обновление может выпустить кто
# угодно. Восстановить утраченный ключ нельзя: приложение в Google Play,
# потерявшее ключ, обновить уже не получится никогда.
#
# ---------------------------------------------------------------------------
# ОТЛАДОЧНЫЙ КЛЮЧ (то, чем подписан APK из artifacts/)
# ---------------------------------------------------------------------------
#
# Отдельно заводить не нужно: Android SDK создаёт его сам при первой сборке.
#   путь:   ~/.android/debug.keystore
#   alias:  androiddebugkey
#   пароли: android / android  (одинаковые, так задумано в SDK)
#
# Если файла нет, создайте:
#   keytool -genkeypair -v -keystore ~/.android/debug.keystore \
#     -storepass android -keypass android -alias androiddebugkey \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -dname "CN=Android Debug,O=Android,C=US"
#
# ---------------------------------------------------------------------------
# БОЕВОЙ КЛЮЧ (нужен для Google Play, сейчас не заведён)
# ---------------------------------------------------------------------------
#
#   keytool -genkeypair -v -keystore ~/keys/recipetocup-release.jks \
#     -alias recipetocup -keyalg RSA -keysize 2048 -validity 10000
#
# Срок 10000 дней (27 лет) — требование Google Play: ключ должен быть
# действителен как минимум до 22 октября 2033 года.
#
# Файл .jks положите ВНЕ репозитория и сделайте резервную копию в двух
# местах. Это единственный файл в проекте, потеря которого необратима.

storeFile=/Users/<вы>/keys/recipetocup-release.jks
storePassword=<ЗАПОЛНИТЬ: пароль хранилища>
keyAlias=recipetocup
keyPassword=<ЗАПОЛНИТЬ: пароль ключа>
