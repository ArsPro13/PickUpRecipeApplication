<?xml version="1.0" encoding="utf-8"?>
<!--
    Политика сетевой безопасности релизной сборки.

    Открытый http запрещён целиком и без исключений. Это не перестраховка:
    приложение носит адрес почты, пароль и токен сессии, и единственная
    http-ручка в списке — это вся сессия, отданная любому, кто сидит на том
    же Wi-Fi.

    Отладочная сборка перекрывает этот файл своим (src/debug/res/xml):
    локальный бэкенд поднимается без TLS, и требовать его там значило бы
    сломать разработку ради строчки в манифесте, которая до пользователя
    всё равно не доедет.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Только системные центры сертификации. Пользовательские
                 намеренно не доверяем: сертификат, поставленный в систему
                 вручную, — это ровно тот способ, которым читают чужой
                 https-трафик. -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
