<?xml version="1.0" encoding="utf-8"?>
<!--
    Отладочный вариант: открытый http разрешён.

    Локальный бэкенд поднимается без TLS (`make up` в backend/), а андроид
    видит хост как 10.0.2.2. Без этого послабления отладочная сборка не
    достучалась бы до него вовсе.

    В релиз этот файл не попадает: он лежит в src/debug и перекрывает
    основной только при сборке debug-типа. Разница между сборками обязана
    быть видна в конфигурации, а не держаться на памяти разработчика.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <!-- Отладочные сертификаты — только в debug-сборке: так работают
                 прокси-снифферы вроде Charles при разборе своих же запросов. -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
